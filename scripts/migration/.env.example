# WordPress Application Passwords (generate in WP Admin → Users → Profile → Application Passwords)
# Base64 encode as "username:app_password" for Basic auth header

# Main English site
WP_TRIPCANVAS_USERNAME=admin
WP_TRIPCANVAS_APP_PASSWORD=

# Malaysia (ms)
WP_MALAYSIA_USERNAME=admin
WP_MALAYSIA_APP_PASSWORD=

# Indonesia (id)
WP_INDONESIA_USERNAME=admin
WP_INDONESIA_APP_PASSWORD=

# Thailand (th)
WP_THAILAND_USERNAME=admin
WP_THAILAND_APP_PASSWORD=

# ─────────────────────────────────────────────
# Payload CMS target (for migration scripts)
# ─────────────────────────────────────────────
PAYLOAD_API_URL=https://tripcanvas-cms.academyt.workers.dev/api
PAYLOAD_EMAIL=
PAYLOAD_PASSWORD=

# ─────────────────────────────────────────────
# Cloudflare R2 (for direct media upload, optional)
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tripcanvas-media
R2_PUBLIC_URL=

# ─────────────────────────────────────────────
# Migration runtime flags
# ─────────────────────────────────────────────
# DRY_RUN=1 skips all writes to Payload; logs intended operations instead
DRY_RUN=1
# Limit posts per locale (0 = no limit) — useful for dry-run sampling
POST_LIMIT=0