---
import Layout from '../../layouts/Layout.astro';
import { getPosts } from '../../lib/payload';

const locale = (Astro.locals as { locale?: string }).locale || 'en';
const posts = await getPosts(locale);

function displayTitle(post: { title?: string; slug: string }): string {
  return post.title || post.slug.replace(/-/g, ' ');
}

function displayExcerpt(post: { excerpt?: string }): string {
  if (post.excerpt) return post.excerpt;
  return 'A practical travel story from the TripCanvas archive.';
}
---

<Layout title="Stories - TripCanvas" description="Travel stories, destination ideas, and itineraries from the TripCanvas editorial archive.">
  <section class="hero">
    <p class="eyebrow">Editorial archive</p>
    <h1>Stories, tips, and destination deep-dives.</h1>
    <p>Browse guides written for real trips — from city weekends to slow island escapes.</p>
  </section>

  <section>
    <h2 class="section-title">Latest posts</h2>
    {posts.length > 0 ? (
      <div class="post-grid">
        {posts.map((post) => (
          <article class="post-card">
            <span class="post-meta">{new Date(post.createdAt).toLocaleDateString()}</span>
            <h2><a href={`/blog/${post.slug}`}>{displayTitle(post)}</a></h2>
            <p class="post-excerpt">{displayExcerpt(post as { excerpt?: string })}</p>
          </article>
        ))}
      </div>
    ) : (
      <p>No posts found for this locale yet.</p>
    )}
  </section>
</Layout>
