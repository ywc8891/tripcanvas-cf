---
import Layout from '../../layouts/Layout.astro';
import { getPosts, firstImageUrl } from '../../lib/payload';

const locale = (Astro.locals as { locale?: string }).locale || 'en';
const pageParam = Number(Astro.url.searchParams.get('page') || '1');
const currentPage = isNaN(pageParam) || pageParam < 1 ? 1 : pageParam;

const { docs: posts, totalDocs, totalPages, hasNextPage, hasPrevPage } = await getPosts(locale, currentPage);

function displayTitle(post: { title?: string; slug: string }): string {
  return post.title || post.slug.replace(/-/g, ' ');
}

function displayExcerpt(post: { excerpt?: string }): string {
  if (post.excerpt) return post.excerpt;
  return '';
}
---

<Layout title={`Stories${currentPage > 1 ? ` — Page ${currentPage}` : ''} - TripCanvas`} description="Travel stories, destination ideas, and itineraries from the TripCanvas editorial archive.">
  <div class="page-banner">
    <div class="container">
      <h1>Latest Stories</h1>
      <p>Destination guides, food finds, and travel tips from across Southeast Asia.</p>
      {totalDocs > 0 && <p class="page-banner-meta">{totalDocs} articles · Page {currentPage} of {totalPages}</p>}
    </div>
  </div>

  <section class="container">
    <p class="section-title">
      {currentPage > 1 ? `Page ${currentPage} of ${totalPages}` : 'All stories'}
    </p>
    {posts.length > 0 ? (
      <div class="post-grid">
        {posts.map((post) => {
          const excerpt = displayExcerpt(post);
          const thumb = firstImageUrl(post.content);
          return (
            <article class="post-card">
              <a class="post-card-thumb" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true">
                {thumb
                  ? <img src={thumb} alt="" loading="lazy" decoding="async" />
                  : <div class="post-card-thumb-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 20.25h18A1.5 1.5 0 0022.5 18.75V5.25A1.5 1.5 0 0021 3.75H3A1.5 1.5 0 001.5 5.25v13.5A1.5 1.5 0 003 20.25z"/></svg></div>
                }
              </a>
              <div class="post-card-body">
                <h2><a href={`/blog/${post.slug}`}>{displayTitle(post)}</a></h2>
                {excerpt && <p class="post-excerpt">{excerpt}</p>}
                <span class="post-meta">{new Date(post.publishedAt || post.createdAt).toLocaleDateString()}</span>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p>No posts found for this locale yet.</p>
    )}

    {(hasPrevPage || hasNextPage) && (
      <nav class="pagination" aria-label="Page navigation">
        {hasPrevPage
          ? <a class="pagination-btn" href={`/blog?page=${currentPage - 1}`}>← Previous</a>
          : <span class="pagination-btn is-disabled">← Previous</span>
        }
        <span class="pagination-info">Page {currentPage} of {totalPages}</span>
        {hasNextPage
          ? <a class="pagination-btn" href={`/blog?page=${currentPage + 1}`}>Next →</a>
          : <span class="pagination-btn is-disabled">Next →</span>
        }
      </nav>
    )}
  </section>
</Layout>
