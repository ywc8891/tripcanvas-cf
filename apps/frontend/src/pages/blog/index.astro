---
import Layout from '../../layouts/Layout.astro';
import { getPosts, firstImageUrl } from '../../lib/payload';
import { getPostUrl, primaryCategory, localePath } from '../../lib/locale';
import { t } from '../../lib/i18n';

const locale = (Astro.locals as { locale?: string }).locale || 'en';
const pageParam = Number(Astro.url.searchParams.get('page') || '1');
const currentPage = isNaN(pageParam) || pageParam < 1 ? 1 : pageParam;

const isZh = locale === 'zh';
const { docs: rawPosts, totalDocs: rawTotal, totalPages: rawPages, hasNextPage: rawNext, hasPrevPage: rawPrev } = await getPosts(locale, isZh ? 1 : currentPage, isZh ? 200 : 12, isZh ? { fallbackLocale: 'none' } : undefined);
// For ZH, filter to only posts with actual Chinese content
const posts = isZh ? rawPosts.filter(p => p.title) : rawPosts;
const totalDocs = isZh ? posts.length : rawTotal;
const totalPages = isZh ? 1 : rawPages;
const hasNextPage = isZh ? false : rawNext;
const hasPrevPage = isZh ? false : rawPrev;

function displayTitle(post: { title?: string; slug: string }): string {
  return post.title || post.slug.replace(/-/g, ' ');
}

function displayExcerpt(post: { excerpt?: string }): string {
  if (post.excerpt) return post.excerpt;
  return '';
}
---

<Layout title={`Stories${currentPage > 1 ? ` — Page ${currentPage}` : ''} - TripCanvas`} description="Travel stories, destination ideas, and itineraries from the TripCanvas editorial archive.">
  <div class="page-banner">
    <div class="container">
      <h1>{t('nav.stories', locale)}</h1>
      <p>{t('brand.tagline', locale)}</p>
      {totalDocs > 0 && <p class="page-banner-meta">{totalDocs} articles · Page {currentPage} of {totalPages}</p>}
    </div>
  </div>

  <section class="container">
    <p class="section-title">
      {currentPage > 1 ? `Page ${currentPage} of ${totalPages}` : 'All stories'}
    </p>
    {posts.length > 0 ? (
      <div class="post-grid">
        {posts.map((post) => {
          const excerpt = displayExcerpt(post);
          const thumb = firstImageUrl(post.content);
          return (
            <article class="post-card">
              <a class="post-card-thumb" href={getPostUrl(post.slug, locale, primaryCategory(post.categories))} tabindex="-1" aria-hidden="true">
                {thumb
                  ? <img src={thumb} alt="" loading="lazy" decoding="async" />
                  : <div class="post-card-thumb-placeholder"></div>
                }
              </a>
              <span class="post-card-date">{new Date(post.publishedAt || post.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              <div class="post-card-body">
                <h2><a href={getPostUrl(post.slug, locale, primaryCategory(post.categories))}>{displayTitle(post)}</a></h2>
                <a class="post-card-btn" href={getPostUrl(post.slug, locale, primaryCategory(post.categories))}>{t('post.readMore', locale)}</a>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p>{t('home.noStories', locale)}</p>
    )}

    {(hasPrevPage || hasNextPage) && (
      <nav class="pagination" aria-label="Page navigation">
        {hasPrevPage
          ? <a class="pagination-btn" href={localePath(`/blog?page=${currentPage - 1}`, locale)}>← Previous</a>
          : <span class="pagination-btn is-disabled">← Previous</span>
        }
        <span class="pagination-info">Page {currentPage} of {totalPages}</span>
        {hasNextPage
          ? <a class="pagination-btn" href={localePath(`/blog?page=${currentPage + 1}`, locale)}>Next →</a>
          : <span class="pagination-btn is-disabled">Next →</span>
        }
      </nav>
    )}
  </section>
</Layout>
