---
import Layout from '../../layouts/Layout.astro';
import { getPostBySlug } from '../../lib/payload';
import { lexicalToHtml } from '../../lib/lexical';

const { slug } = Astro.params;
const locale = (Astro.locals as { locale?: string }).locale || 'en';

if (!slug) {
  return Astro.redirect('/blog');
}

const post = await getPostBySlug(slug, locale);

if (!post) {
  return Astro.redirect('/404');
}

const displayTitle = post.title || post.slug;
const displayDate = post.publishedAt || post.createdAt;
const metaDesc = (post as unknown as { excerpt?: string }).excerpt
  || `Read ${displayTitle} on TripCanvas.`;
const contentHtml = lexicalToHtml(post.content);
---

<Layout title={`${displayTitle} - TripCanvas`} description={metaDesc}>
  <article class="content-shell">
    <p class="eyebrow">Story</p>
    <h1 class="article-title">{displayTitle}</h1>
    <time class="article-meta" datetime={displayDate}>
      {new Date(displayDate).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>

    <div class="article-content" set:html={contentHtml} />

    <a class="back-link" href="/blog">← Back to stories</a>
  </article>
</Layout>
