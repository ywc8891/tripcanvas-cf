---
import { getPostBySlug } from '../../lib/payload';
import { getPostUrl, primaryCategory } from '../../lib/locale';

const { slug } = Astro.params;
const locale = (Astro.locals as { locale?: string }).locale || 'en';

if (!slug) {
  return Astro.redirect('/');
}

const post = await getPostBySlug(slug, locale);

if (!post) {
  return Astro.redirect('/404');
}

const canonicalCat = primaryCategory(post.categories);
return Astro.redirect(getPostUrl(post.slug, locale, canonicalCat), 301);
---
