---
import Layout from '../../layouts/Layout.astro';
import { getPostsByCategory, firstImageUrl } from '../../lib/payload';
import { getPostUrl, primaryCategory, localePath } from '../../lib/locale';

const { location } = Astro.params;
const locale = (Astro.locals as { locale?: string }).locale || 'en';
const pageParam = Number(Astro.url.searchParams.get('page') || '1');
const currentPage = isNaN(pageParam) || pageParam < 1 ? 1 : pageParam;

if (!location) return Astro.redirect('/');

const { docs: posts, totalDocs, totalPages, hasNextPage, hasPrevPage } =
  await getPostsByCategory(location, locale, currentPage);

if (posts.length === 0 && currentPage === 1) {
  return Astro.redirect('/404');
}

const locationTitle = location.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());

function displayTitle(post: { title?: string; slug: string }): string {
  return post.title || post.slug.replace(/-/g, ' ');
}
---

<Layout title={`${locationTitle} - TripCanvas`} description={`Travel guides and stories for ${locationTitle}.`}>
  <div class="page-banner">
    <div class="container">
      <h1>{locationTitle}</h1>
      <p>Travel guides, food finds, and tips from {locationTitle}.</p>
      {totalDocs > 0 && <p class="page-banner-meta">{totalDocs} articles · Page {currentPage} of {totalPages}</p>}
    </div>
  </div>

  <section class="container">
    <p class="section-title">
      {currentPage > 1 ? `Page ${currentPage} of ${totalPages}` : `All ${locationTitle} stories`}
    </p>
    <div class="post-grid">
      {posts.map((post) => {
        const thumb = firstImageUrl(post.content);
        const postUrl = getPostUrl(post.slug, locale, primaryCategory(post.categories));
        return (
          <article class="post-card">
            <a class="post-card-thumb" href={postUrl} tabindex="-1" aria-hidden="true">
              {thumb
                ? <img src={thumb} alt="" loading="lazy" decoding="async" />
                : <div class="post-card-thumb-placeholder"></div>
              }
            </a>
            <span class="post-card-date">{new Date(post.publishedAt || post.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
            <div class="post-card-body">
              <h2><a href={postUrl}>{displayTitle(post)}</a></h2>
              <a class="post-card-btn" href={postUrl}>Read More</a>
            </div>
          </article>
        );
      })}
    </div>

    {(hasPrevPage || hasNextPage) && (
      <nav class="pagination" aria-label="Page navigation">
        {hasPrevPage
          ? <a class="pagination-btn" href={localePath(`/${location}?page=${currentPage - 1}`, locale)}>← Previous</a>
          : <span class="pagination-btn is-disabled">← Previous</span>
        }
        <span class="pagination-info">Page {currentPage} of {totalPages}</span>
        {hasNextPage
          ? <a class="pagination-btn" href={localePath(`/${location}?page=${currentPage + 1}`, locale)}>Next →</a>
          : <span class="pagination-btn is-disabled">Next →</span>
        }
      </nav>
    )}
  </section>
</Layout>
