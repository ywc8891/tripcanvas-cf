---
import Layout from '../../layouts/Layout.astro';
import { marketFromHost } from '../../lib/locale';
import { MARKET_SOCIAL } from '../../lib/i18n';
import { t } from '../../lib/i18n';

const host = (Astro.locals as { host?: string }).host || Astro.url.hostname;
const locale = (Astro.locals as { locale?: string }).locale || 'en';
const market = marketFromHost(host);
const marketName: Record<string, string> = { en: 'Southeast Asia', my: 'Malaysia', id: 'Indonesia', th: 'Thailand' };
const name = marketName[market] || 'Southeast Asia';
const social = MARKET_SOCIAL[market];
---

<Layout title={`${t('static.contact.title', locale)} ${name}`} description={`Get in touch with TripCanvas ${name}.`}>
  <div class="page-banner">
    <div class="page-banner-overlay no-bg">
      <div class="container">
        <h1>{t('static.contact.title', locale)}</h1>
      </div>
    </div>
  </div>
  <div class="container" style="max-width:720px; padding:2rem 0 4rem;">
    <div class="rich-text" set:html={t('static.contact.content', locale)}></div>
    <div style="margin-top:2rem;">
      <p><strong>Email:</strong> <a href="mailto:hello@tripcanvas.co">hello@tripcanvas.co</a></p>
      <p><strong>Phone:</strong> +603 8408 5542</p>
    </div>
    {social && (
      <div style="margin-top:1.5rem;">
        <p><strong>Follow us:</strong></p>
        <p>
          {social.facebook && <a href={social.facebook} target="_blank" style="margin-right:1rem;"><i class="fa fa-facebook"></i> Facebook</a>}
          {social.twitter && <a href={social.twitter} target="_blank" style="margin-right:1rem;"><i class="fa fa-twitter"></i> Twitter</a>}
          {social.youtube && <a href={social.youtube} target="_blank" style="margin-right:1rem;"><i class="fa fa-youtube-play"></i> YouTube</a>}
          {social.instagram && <a href={social.instagram} target="_blank"><i class="fa fa-instagram"></i> Instagram</a>}
        </p>
      </div>
    )}
  </div>
</Layout>
