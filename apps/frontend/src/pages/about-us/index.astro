---
import Layout from '../../layouts/Layout.astro';
import { marketFromHost } from '../../lib/locale';
import { t } from '../../lib/i18n';

const host = (Astro.locals as { host?: string }).host || Astro.url.hostname;
const locale = (Astro.locals as { locale?: string }).locale || 'en';
const market = marketFromHost(host);
const marketName: Record<string, string> = { en: 'Southeast Asia', my: 'Malaysia', id: 'Indonesia', th: 'Thailand' };
const name = marketName[market] || 'Southeast Asia';
---

<Layout title={t('static.about.title', locale)} description={`About TripCanvas ${name}`}>
  <div class="page-banner">
    <div class="page-banner-overlay no-bg">
      <div class="container">
        <h1>{t('static.about.title', locale)}</h1>
      </div>
    </div>
  </div>
  <div class="container" style="max-width:720px; padding:2rem 0 4rem;">
    <div class="rich-text" set:html={t('static.about.content', locale)}></div>
  </div>
</Layout>
