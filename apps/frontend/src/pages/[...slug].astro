---
import { getPostBySlug } from '../lib/payload';

const rawSlug = Astro.params.slug;
const locale = (Astro.locals as { locale?: string }).locale || 'en';
const pathname = Astro.url.pathname;

const isInternalAssetPath = pathname.startsWith('/_astro/') || pathname.startsWith('/_image/');
const lastPathSegment = pathname.split('/').filter(Boolean).pop() || '';
const hasFileExtension = /\.[a-z0-9]+$/i.test(lastPathSegment);

if (isInternalAssetPath || hasFileExtension) {
  return new Response('Not found', { status: 404 });
}

if (!rawSlug) {
  return Astro.redirect('/blog');
}

const segments = rawSlug.split('/').filter(Boolean);
const finalSlug = segments[segments.length - 1];

if (!finalSlug) {
  return Astro.redirect('/blog');
}

const post = await getPostBySlug(finalSlug, locale);

if (!post) {
  return Astro.redirect('/404');
}

return Astro.redirect(`/blog/${post.slug}`, 301);
---
