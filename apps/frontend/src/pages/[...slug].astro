---
import { getPostBySlug, getPostsByCategory } from '../lib/payload';
import { getPostUrl, primaryCategory, localePath } from '../lib/locale';

const rawSlug = Astro.params.slug;
const locale = (Astro.locals as { locale?: string }).locale || 'en';
const pathname = Astro.url.pathname;

const isInternalAssetPath = pathname.startsWith('/_astro/') || pathname.startsWith('/_image/');
const lastPathSegment = pathname.split('/').filter(Boolean).pop() || '';
const hasFileExtension = /\.[a-z0-9]+$/i.test(lastPathSegment);

if (isInternalAssetPath || hasFileExtension) {
  return new Response('Not found', { status: 404 });
}

if (!rawSlug) {
  return Astro.redirect('/');
}

const segments = rawSlug.split('/').filter(Boolean);
const finalSlug = segments[segments.length - 1];

if (!finalSlug) {
  return Astro.redirect('/');
}

// Try to resolve as a post first
const post = await getPostBySlug(finalSlug, locale);
if (post) {
  return Astro.redirect(getPostUrl(post.slug, locale, primaryCategory(post.categories)), 301);
}

// Single-segment path that didn't match a post — try as a category
if (segments.length === 1) {
  const catResult = await getPostsByCategory(finalSlug, locale, 1, 1);
  if (catResult.totalDocs > 0) {
    return Astro.redirect(localePath(`/${finalSlug}`, locale), 301);
  }
}

return Astro.redirect('/404');
---
