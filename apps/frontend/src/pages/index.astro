---
import Layout from '../layouts/Layout.astro';
import { getCategories, getPostByWpId, getPosts, firstImageUrl } from '../lib/payload';

const locale = (Astro.locals as { locale?: string }).locale || 'en';
const wpIdParam = Astro.url.searchParams.get('p');

if (wpIdParam && /^\d+$/.test(wpIdParam)) {
  const legacyPost = await getPostByWpId(Number(wpIdParam), locale);
  if (legacyPost?.slug) {
    return Astro.redirect(`/blog/${legacyPost.slug}`, 301);
  }
}

const { docs: allPosts } = await getPosts(locale);
const categories = await getCategories(locale);
const featuredPosts = allPosts.slice(0, 6);

function displayTitle(post: { title?: string; slug: string }): string {
  return post.title || post.slug.replace(/-/g, ' ');
}

function displayExcerpt(post: { excerpt?: string }): string {
  if (post.excerpt) return post.excerpt;
  return 'Explore practical tips, local food picks, and itinerary ideas from the TripCanvas archive.';
}
---

<Layout title="TripCanvas - Travel Blog" description="Destination stories and practical travel guides across Southeast Asia.">
  <section class="hero">
    <p class="eyebrow">Southeast Asia Travel Journal</p>
    <h1>Find where to go next, what to eat, and how to travel smarter.</h1>
    <p>
      TripCanvas curates destination stories, local tips, and neighborhood finds for travelers moving through
      Malaysia, Indonesia, Thailand, and beyond.
    </p>
  </section>

  <section>
    <h2 class="section-title">Featured stories</h2>
    {featuredPosts.length > 0 ? (
      <div class="post-grid">
        {featuredPosts.map((post) => {
          const excerpt = displayExcerpt(post as { excerpt?: string });
          const thumb = firstImageUrl(post.content);
          return (
            <article class="post-card">
              <a class="post-card-thumb" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true">
                {thumb
                  ? <img src={thumb} alt="" loading="lazy" decoding="async" />
                  : <div class="post-card-thumb-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 20.25h18A1.5 1.5 0 0022.5 18.75V5.25A1.5 1.5 0 0021 3.75H3A1.5 1.5 0 001.5 5.25v13.5A1.5 1.5 0 003 20.25z"/></svg></div>
                }
              </a>
              <div class="post-card-body">
                <h3><a href={`/blog/${post.slug}`}>{displayTitle(post)}</a></h3>
                {excerpt && excerpt !== 'Explore practical tips, local food picks, and itinerary ideas from the TripCanvas archive.' && <p class="post-excerpt">{excerpt}</p>}
                <span class="post-meta">{new Date(post.createdAt).toLocaleDateString()}</span>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <p>No posts found for this locale yet.</p>
    )}
  </section>

  <section>
    <h2 class="section-title">Browse by category</h2>
    {categories.length > 0 ? (
      <div class="chip-row">
        {categories.slice(0, 18).map((category) => (
          <a class="chip" href={`/blog?category=${category.slug}`}>
            {category.name || category.slug.replace(/-/g, ' ')}
          </a>
        ))}
      </div>
    ) : (
      <p>Categories will appear once localized names are available for this locale.</p>
    )}
  </section>
</Layout>
