---
import { marketFromHost, getPostUrl, primaryCategory } from '../lib/locale';
import { getPostByWpId } from '../lib/payload';

import HubHome from '../components/homepage/HubHome.astro';
import MyHomeEn from '../components/homepage/MyHomeEn.astro';
import MyHomeZh from '../components/homepage/MyHomeZh.astro';
import IdHomeId from '../components/homepage/IdHomeId.astro';
import IdHomeZh from '../components/homepage/IdHomeZh.astro';
import ThHomeEn from '../components/homepage/ThHomeEn.astro';
import ThHomeZh from '../components/homepage/ThHomeZh.astro';
import ThHomeId from '../components/homepage/ThHomeId.astro';

const locale = (Astro.locals as { locale?: string }).locale || 'en';
const wpIdParam = Astro.url.searchParams.get('p');

if (wpIdParam && /^\d+$/.test(wpIdParam)) {
  const legacyPost = await getPostByWpId(Number(wpIdParam), locale);
  if (legacyPost?.slug) {
    return Astro.redirect(getPostUrl(legacyPost.slug, locale, primaryCategory(legacyPost.categories)), 301);
  }
}

const host = (Astro.locals as { host?: string }).host || Astro.url.hostname;
const market = marketFromHost(host);
---

{market === 'en' && <HubHome />}
{market === 'my' && locale === 'zh' && <MyHomeZh />}
{market === 'my' && <MyHomeEn />}
{market === 'id' && locale === 'zh' && <IdHomeZh />}
{market === 'id' && <IdHomeId />}
{market === 'th' && locale === 'zh' && <ThHomeZh />}
{market === 'th' && locale === 'id' && <ThHomeId />}
{market === 'th' && <ThHomeEn />}
