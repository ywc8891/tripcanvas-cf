---
import Layout from '../../layouts/Layout.astro';
import FullImageHero from '../../components/FullImageHero.astro';
import SubscriptionBox from '../../components/SubscriptionBox.astro';
import { getPosts, firstImageUrl } from '../../lib/payload';
import { getPostUrl, primaryCategory, localePath, isStagingWorker } from '../../lib/locale';
import { t } from '../../lib/i18n';

const locale = 'zh';
const host = (Astro.locals as { host?: string }).host || Astro.url.hostname;
const market = 'my';
const staging = isStagingWorker(host);
const MARKET_DOMAIN: Record<string, string> = { my: staging ? 'tripcanvas-my.academyt.workers.dev' : 'malaysia.tripcanvas.co' };
const meta = { name: 'TripCanvas － 非一般的大马旅游攻略', tagline: '非一般的大马旅游攻略', description: '非一般的大马旅游攻略' };
const { docs: rawPosts } = await getPosts(locale, 1, 80, { fallbackLocale: 'none' });
const featuredPosts = rawPosts.filter((p: any) => p.title).slice(0, 8);
const ogImage = featuredPosts[0] ? firstImageUrl(featuredPosts[0].content) : undefined;
const canonical = staging ? undefined : `https://${MARKET_DOMAIN.my}/zh/`;

function displayTitle(post: { title?: string; slug: string }): string {
  return post.title || post.slug.replace(/-/g, ' ');
}
---

<Layout title={meta.name} description={meta.description} ogImage={ogImage} canonical={canonical}>
  <FullImageHero market={market} locale={locale} />

  <div class="container" style="padding-top:2rem; padding-bottom:4rem;">
    {featuredPosts.length > 0 ? (
      <>
        <p class="section-title">{t('home.featured', locale)} | {meta.tagline}</p>
        <div class="featured-grid">
          {featuredPosts.map((post: any, idx: number) => {
            const thumb = firstImageUrl(post.content);
            const postDate = new Date(post.publishedAt || post.createdAt).toLocaleDateString('zh-CN', { day: 'numeric', month: 'short', year: 'numeric' });
            const cats = post.categories || [];
            return (
              <article class={`post-card${idx === 0 ? ' post-card-featured' : ''}`}>
                <a class="post-card-thumb" href={getPostUrl(post.slug, locale, primaryCategory(post.categories))} tabindex="-1" aria-hidden="true">
                  {thumb ? <img src={thumb} alt="" loading="lazy" decoding="async" /> : <div class="post-card-thumb-placeholder"></div>}
                </a>
                <span class="post-card-date"><i class="fa fa-bookmark"></i> {postDate}</span>
                <div class="post-card-body">
                  <div class="badge">
                    {cats.slice(0, 2).map((cat: any) => (
                      <a href={localePath(`/${cat.slug}`, locale)} class="category-chip">{cat.name || cat.slug.replace(/-/g, ' ')}</a>
                    ))}
                    <div class="clear"></div>
                  </div>
                  <h3><a href={getPostUrl(post.slug, locale, primaryCategory(post.categories))}>{displayTitle(post)}</a></h3>
                  <a class="button-outline" href={getPostUrl(post.slug, locale, primaryCategory(post.categories))}>{t('post.readMore', locale)}</a>
                </div>
              </article>
            );
          })}
        </div>
        <div style="margin-top:1.5rem; text-align:right;">
          <a href="/zh/blog" class="home-view-all">{t('home.viewAll', locale)}</a>
        </div>
      </>
    ) : (
      <p style="color:var(--muted);">{t('home.noStories', locale)}</p>
    )}
  </div>

  <SubscriptionBox market={market} locale={locale} />
</Layout>
