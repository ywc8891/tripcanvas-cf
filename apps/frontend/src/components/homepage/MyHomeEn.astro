---
import Layout from '../../layouts/Layout.astro';
import FullImageHero from '../../components/FullImageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/payload';
import { localePath, isStagingWorker } from '../../lib/locale';
import { t } from '../../lib/i18n';

const locale = 'en';
const host = (Astro.locals as { host?: string }).host || Astro.url.hostname;
const market = 'my';
const staging = isStagingWorker(host);
const MARKET_DOMAIN: Record<string, string> = { my: staging ? 'tripcanvas-my.academyt.workers.dev' : 'malaysia.tripcanvas.co' };
const meta = { name: 'TripCanvas - Not Your Usual Malaysia Travel Guide', tagline: 'Not Your Usual Malaysia Travel Guide', description: 'We share unique information on hotels, villas, things to do and dining places in Malaysia that you never knew existed.' };
const { docs: homePosts } = await getPosts(locale, 1, 8);
const { firstImageUrl } = await import('../../lib/payload');
const ogImage = homePosts[0] ? firstImageUrl(homePosts[0].content) : undefined;
const canonical = staging ? undefined : `https://${MARKET_DOMAIN.my}/`;
---

<Layout title={meta.name} description={meta.description} ogImage={ogImage} canonical={canonical}>
  <div class="content-section content-full section first-section no-title" style="margin-top:0;">
    <div class="col-md-12" style="padding-left:0;padding-right:0;">
      <FullImageHero market={market} locale={locale} />
    </div>
    <div class="clear"></div>
  </div>

  <div class="content-section content-full section not-first-section no-title">
    <div class="col-md-12" style="padding-left:0;padding-right:0;">
      <div class="container" style="margin-top:20px;">
        <div class="su-note" style="border-color:#e5e3ba;border-radius:3px;">
          <div class="su-note-inner su-clearfix" style="background-color:#fffccf;border:1px solid #ff6000;color:#333;border-radius:3px;padding:10px;">
            <a class="su-button su-button-style-default" style="color:#ff6000;font-family:Open Sans;font-size:15px;font-weight:200;" href="/news/covid19-updates/">Here is our coverage on COVID-19 (FAQs, useful info, etc) <i class="fa fa-arrow-circle-right"></i></a>
          </div>
        </div>
      </div>
    </div>
    <div class="clear"></div>
  </div>

  <div class="no-top-margin grid grid-full section not-first-section has-title">
    <div class="container">
      <div class="imagegrid full col-md-12">
        <div class="section-title"><p><span>{t('home.featured', locale)}<span class="vertical-div"> | </span></span>{meta.tagline}</p><h2></h2></div>
        <div class="loading"></div>
        <div class="grid-wrapper">
          <div class="homeposts grid-full">
            <div class="isotopecontainer" data-value="3">{homePosts.map(post => <PostCard post={post} locale={locale} />)}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="content-section content-full section not-first-section no-title">
    <div class="col-md-12" style="padding-left:0;padding-right:0;">
      <div class="subscription-box">
        <div class="container">
          <h2 class="subscription-box-title">Get more Malaysia travel ideas <span>in your inbox!</span></h2>
          <p class="subscription-box-desc">Sign up for our monthly email and be inspired with Malaysia travel ideas that you'd love.</p>
          <form class="subscription-box-form" method="post" target="_blank">
            <input type="email" class="subscription-box-input" placeholder="Enter Your Email Address" required />
            <input type="submit" class="subscription-box-btn" value="Sign me up!" />
          </form>
        </div>
      </div>
    </div>
    <div class="clear"></div>
  </div>

  <div class="content-section content-full section not-first-section no-title">
    <div class="col-md-12" style="padding-left:0;padding-right:0;"><div class="ad-slot">Advertisement</div></div>
    <div class="clear"></div>
  </div>
</Layout>
