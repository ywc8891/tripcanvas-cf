---
import Layout from '../../layouts/Layout.astro';
import FullImageHero from '../../components/FullImageHero.astro';
import SubscriptionBox from '../../components/SubscriptionBox.astro';
import { getPosts, getPostsByCategory, firstImageUrl } from '../../lib/payload';
import { getPostUrl, primaryCategory, localePath, isStagingWorker } from '../../lib/locale';
import { t } from '../../lib/i18n';
import { MARKET_SOCIAL } from '../../lib/i18n';

const locale = 'en';
const host = (Astro.locals as { host?: string }).host || Astro.url.hostname;
const market = 'th';
const staging = isStagingWorker(host);
const MARKET_DOMAIN: Record<string, string> = { th: staging ? 'tripcanvas-th.academyt.workers.dev' : 'thailand.tripcanvas.co' };
const meta = { name: 'TripCanvas Thailand', tagline: 'Not Your Usual Thailand Travel Guide', description: 'We share unique information on hotels, villas, things to do and dining places in Thailand that you never knew existed.' };
const { docs: rawPosts } = await getPosts(locale, 1, 8);
const featuredPosts = rawPosts.slice(0, 8);
const ogImage = featuredPosts[0] ? firstImageUrl(featuredPosts[0].content) : undefined;
const canonical = staging ? undefined : `https://${MARKET_DOMAIN.th}/`;
const social = MARKET_SOCIAL[market];

const categorySections = [
  { slug: 'bangkok', heading: 'Best of Bangkok', limit: 8 },
  { slug: 'hua-hin', heading: 'Best of Hua Hin', limit: 4 },
  { slug: 'khao-yai', heading: 'Best of Khao Yai', limit: 4 },
  { slug: 'chonburi', heading: 'Best of Pattaya and Chonburi', limit: 3 },
];

const sectionPosts = await Promise.all(
  categorySections.map(s => getPostsByCategory(s.slug, locale, 1, s.limit).then(r => ({ ...s, posts: r.docs })))
);

function displayTitle(post: any) { return post.title || post.slug.replace(/-/g, ' '); }
function sectionUrl(slug: string) { return localePath(`/${slug}`, locale); }
---

<Layout title={meta.name} description={meta.description} ogImage={ogImage} canonical={canonical}>
  <FullImageHero market={market} locale={locale} />

  {social && (
    <div class="follow-bar">
      <div class="container">
        <span class="follow-bar-title">{t('home.followUs', locale)} Thailand</span>
        <div class="follow-bar-links">
          <a href={social.facebook} target="_blank"><i class="fa fa-facebook"></i></a>
          <a href={social.twitter} target="_blank"><i class="fa fa-twitter"></i></a>
          <a href={social.youtube} target="_blank"><i class="fa fa-youtube-play"></i></a>
          <a href={social.instagram} target="_blank"><i class="fa fa-instagram"></i></a>
        </div>
      </div>
    </div>
  )}

  <div class="covid-banner">
    <div class="container">
      <h3 class="covid-banner-title">{t('home.covid.title', locale)}</h3>
      <p class="covid-banner-desc">{t('home.covid.content', locale)}</p>
      <a class="covid-banner-link" href="/news/covid19-updates/">{t('home.covid.link', locale)}</a>
    </div>
  </div>

  <div class="container" style="padding-top:2rem; padding-bottom:4rem;">
    {featuredPosts.length > 0 ? (
      <>
        <p class="section-title">{t('home.featured', locale)} | {meta.tagline}</p>
        <div class="featured-grid">
          {featuredPosts.map((post, idx) => {
            const thumb = firstImageUrl(post.content);
            const postDate = new Date(post.publishedAt || post.createdAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
            const cats = post.categories || [];
            return (
              <article class={`post-card${idx === 0 ? ' post-card-featured' : ''}`}>
                <a class="post-card-thumb" href={getPostUrl(post.slug, locale, primaryCategory(post.categories))} tabindex="-1">
                  {thumb ? <img src={thumb} alt="" loading="lazy" /> : <div class="post-card-thumb-placeholder"></div>}
                </a>
                <span class="post-card-date"><i class="fa fa-bookmark"></i> {postDate}</span>
                <div class="post-card-body">
                  <div class="badge">{cats.slice(0, 2).map((cat: any) => <a href={`/${cat.slug}`} class="category-chip">{cat.name || cat.slug}</a>)}<div class="clear"></div></div>
                  <h3><a href={getPostUrl(post.slug, locale, primaryCategory(post.categories))}>{displayTitle(post)}</a></h3>
                  <a class="button-outline" href={getPostUrl(post.slug, locale, primaryCategory(post.categories))}>{t('post.readMore', locale)}</a>
                </div>
              </article>
            );
          })}
        </div>
        <div style="margin-top:1.5rem; text-align:right;">
          <a href="/blog" class="home-view-all">{t('home.viewAll', locale)}</a>
        </div>
      </>
    ) : (
      <p style="color:var(--muted);">{t('home.noStories', locale)}</p>
    )}
  </div>

  <div class="ad-slot ad-slot-responsive">Advertisement</div>

  {sectionPosts.map((section) => (
    <div class="category-section">
      <div class="container">
        <div class="category-section-header">
          <h3 class="category-section-title">{section.heading}</h3>
        </div>
        <div class="category-section-grid">
          {section.posts.slice(0, section.limit).map((post: any) => {
            const thumb = firstImageUrl(post.content);
            const cats = post.categories || [];
            return (
              <article class="post-card">
                <a class="post-card-thumb" href={getPostUrl(post.slug, locale, primaryCategory(post.categories))} tabindex="-1">
                  {thumb ? <img src={thumb} alt="" loading="lazy" /> : <div class="post-card-thumb-placeholder"></div>}
                </a>
                <span class="post-card-date"><i class="fa fa-bookmark"></i> {new Date(post.publishedAt || post.createdAt).toLocaleDateString('en-GB', {day:'numeric',month:'short',year:'numeric'})}</span>
                <div class="post-card-body">
                  <div class="badge">{cats.slice(0, 1).map((c: any) => <a href={`/${c.slug}`} class="category-chip">{c.name || c.slug}</a>)}<div class="clear"></div></div>
                  <h3><a href={getPostUrl(post.slug, locale, primaryCategory(post.categories))}>{displayTitle(post)}</a></h3>
                </div>
              </article>
            );
          })}
        </div>
        <a class="category-section-more" href={sectionUrl(section.slug)}>
          {t('home.categorySection.more', locale, { destination: section.heading.replace('Best of ', '') })}
        </a>
      </div>
    </div>
  ))}

  <SubscriptionBox market={market} locale={locale} />
</Layout>
