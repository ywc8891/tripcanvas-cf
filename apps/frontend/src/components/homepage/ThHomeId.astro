---
import Layout from '../../layouts/Layout.astro';
import FullImageHero from '../../components/FullImageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getPostsByCategory } from '../../lib/payload';
import { localePath, isStagingWorker } from '../../lib/locale';
import { t } from '../../lib/i18n';

const locale = 'id';
const host = (Astro.locals as { host?: string }).host || Astro.url.hostname;
const market = 'th';
const staging = isStagingWorker(host);
const MARKET_DOMAIN: Record<string, string> = { th: staging ? 'tripcanvas-th-id.academyt.workers.dev' : 'thailand.tripcanvas.co' };
const meta = { name: 'TripCanvas Thailand', tagline: 'Bukan Panduan Liburan Thailand Biasa Anda', description: 'Panduan liburan Thailand yang unik' };
const canonical = staging ? undefined : `https://${MARKET_DOMAIN.th}/id/`;
const { docs: homePosts } = await getPosts(locale, 1, 8);
const bestOfBangkok = await getPostsByCategory('bangkok', locale, 1, 8);
const bestOfHuaHin = await getPostsByCategory('hua-hin', locale, 1, 4);
const bestOfKhaoYai = await getPostsByCategory('khao-yai', locale, 1, 4);
const bestOfPattaya = await getPostsByCategory('chonburi', locale, 1, 4);
const { firstImageUrl } = await import('../../lib/payload');
const ogImage = homePosts[0] ? firstImageUrl(homePosts[0].content) : undefined;

function sectionUrl(slug: string) { return localePath(`/${slug}`, locale); }
---

<Layout title={meta.name} description={meta.description} ogImage={ogImage} canonical={canonical}>
  <FullImageHero market={market} locale={locale} />

  <div class="no-top-margin grid grid-full section not-first-section has-title">
    <div class="container">
      <div class="imagegrid full col-md-12">
        <div class="section-title"><p><span>{t('home.featured', locale)}<span class="vertical-div"> | </span></span>{meta.tagline}</p><h2></h2></div>
        <div class="loading"></div>
        <div class="grid-wrapper">
          <div class="homeposts grid-full">
            <div class="isotopecontainer" data-value="3">{homePosts.map(post => <PostCard post={post} locale={locale} />)}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="no-top-margin grid grid-full section not-first-section has-title">
    <div class="container">
      <div class="imagegrid full col-md-12">
        <p class="section-title"><span>Best of Bangkok</span></p><h2></h2>
        <div class="loading"></div>
        <div class="grid-wrapper">
          <div class="homeposts grid-full">
            <div class="isotopecontainer" data-value="3">{bestOfBangkok.docs.map(post => <PostCard post={post} locale={locale} />)}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="homesection ad-section section not-first-section">
    <div class="container"><div class="col-md-12"><a href={sectionUrl('bangkok')} class="home-section-cta">{t('home.categorySection.more', locale, { destination: 'Bangkok' })}</a></div></div>
  </div>

  <div class="content-section content-full section not-first-section no-title">
    <div class="col-md-12" style="padding-left:0;padding-right:0;">
      <div class="subscription-box">
        <div class="container">
          <h2 class="subscription-box-title">Dapatkan ide liburan di Thailand <span>in your inbox!</span></h2>
          <p class="subscription-box-desc">Daftar ke buletin bulanan kami dan Anda akan terinspirasi oleh berbagai ide untuk liburan di Thailand yang pasti Anda suka.</p>
          <form class="subscription-box-form" method="post" target="_blank">
            <input type="email" class="subscription-box-input" placeholder="Masukkan Alamat Email" required />
            <input type="submit" class="subscription-box-btn" value="Daftar!" />
          </form>
        </div>
      </div>
    </div>
    <div class="clear"></div>
  </div>

  <div class="no-top-margin grid grid-full section not-first-section has-title">
    <div class="container">
      <div class="imagegrid full col-md-12">
        <p class="section-title"><span>Best of Hua Hin</span></p><h2></h2>
        <div class="loading"></div>
        <div class="grid-wrapper">
          <div class="homeposts grid-full">
            <div class="isotopecontainer" data-value="3">{bestOfHuaHin.docs.map(post => <PostCard post={post} locale={locale} />)}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="homesection ad-section section not-first-section">
    <div class="container"><div class="col-md-12"><a href={sectionUrl('hua-hin')} class="home-section-cta">{t('home.categorySection.more', locale, { destination: 'Hua Hin' })}</a></div></div>
  </div>

  <div class="no-top-margin grid grid-full section not-first-section has-title">
    <div class="container">
      <div class="imagegrid full col-md-12">
        <p class="section-title"><span>Best of Khao Yai</span></p><h2></h2>
        <div class="loading"></div>
        <div class="grid-wrapper">
          <div class="homeposts grid-full">
            <div class="isotopecontainer" data-value="3">{bestOfKhaoYai.docs.map(post => <PostCard post={post} locale={locale} />)}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="homesection ad-section section not-first-section">
    <div class="container"><div class="col-md-12"><a href={sectionUrl('khao-yai')} class="home-section-cta">{t('home.categorySection.more', locale, { destination: 'Khao Yai' })}</a></div></div>
  </div>

  <div class="no-top-margin grid grid-full section not-first-section has-title">
    <div class="container">
      <div class="imagegrid full col-md-12">
        <p class="section-title"><span>Best of Pattaya and Chonburi</span></p><h2></h2>
        <div class="loading"></div>
        <div class="grid-wrapper">
          <div class="homeposts grid-full">
            <div class="isotopecontainer" data-value="3">{bestOfPattaya.docs.slice(0, 4).map(post => <PostCard post={post} locale={locale} />)}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="homesection ad-section section not-first-section">
    <div class="container"><div class="col-md-12"><a href={sectionUrl('chonburi')} class="home-section-cta">{t('home.categorySection.more', locale, { destination: 'Pattaya and Chonburi' })}</a></div></div>
  </div>
</Layout>
