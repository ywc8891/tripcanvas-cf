---

<footer class="site-footer-extended">
  <div class="container">
    <div class="site-footer-columns">
      {columns.map((col) => (
        <div class="footer-column">
          <h4 class="footer-column-title">{col.heading}</h4>
          <ul class="footer-column-links">
            {col.links.map((link) => (
              link.children ? (
                <li>
                  <a href={link.href} class="footer-column-parent">{link.label}</a>
                  <ul class="footer-column-sublinks">
                    {link.children.map((child) => (
                      <li><a href={child.href}>{child.label}</a></li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li><a href={link.href}>{link.label}</a></li>
              )
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="site-footer-extended-bottom">
    <div class="container">
      <p>Brought to you from South East Asia for South East Asia</p>
    </div>
  </div>
</footer>
