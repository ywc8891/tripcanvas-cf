---
import { MARKET_SOCIAL } from '../lib/i18n';
import { localePath } from '../lib/locale';

interface Props { market: string; locale: string; }
const { market, locale } = Astro.props;

const HERO_CONFIG: Record<string, {
  bgImage: string;
  bannerLogo: string;
  tagline: string;
  guideButtons: { label: string; href: string }[];
  socialRss?: boolean;
}> = {
  'my_en': {
    bgImage: 'https://malaysia.tripcanvas.co/wp-content/uploads/2019/12/Malaysia-Kuala-Lumpur-Skyline-View.jpg',
    bannerLogo: 'https://malaysia.tripcanvas.co/wp-content/uploads/2019/07/Tripcanvas-MY-banner.png',
    tagline: 'Not Your Usual Malaysia Travel Guide',
    guideButtons: [
      { label: 'Indonesia Guide', href: 'https://indonesia.tripcanvas.co' },
      { label: 'Thailand Guide', href: 'https://thailand.tripcanvas.co' },
    ],
  },
  'my_zh': {
    bgImage: 'https://malaysia.tripcanvas.co/wp-content/uploads/2019/12/Malaysia-Kuala-Lumpur-Skyline-View.jpg',
    bannerLogo: 'https://indonesia.tripcanvas.co/wp-content/uploads/2015/05/Tripcanvas-banner.png',
    tagline: '非一般的大马旅游攻略',
    guideButtons: [
      { label: '印尼旅游攻略', href: 'https://indonesia.tripcanvas.co' },
      { label: '泰国旅游攻略', href: 'https://thailand.tripcanvas.co' },
    ],
  },
  'id_id': {
    bgImage: 'https://indonesia.tripcanvas.co/wp-content/uploads/2019/09/cover-picture-tripcanvas-indo-bromo.jpg',
    bannerLogo: 'https://indonesia.tripcanvas.co/wp-content/uploads/2015/05/Tripcanvas-banner.png',
    tagline: 'Not Your Usual Indonesia Travel Guide',
    guideButtons: [
      { label: 'Bali Guide', href: '/bali/' },
      { label: 'Bandung Guide', href: '/bandung/' },
      { label: 'Jogja Guide', href: '/jogja/' },
      { label: 'Lombok Guide', href: '/lombok/' },
    ],
  },
  'id_zh': {
    bgImage: 'https://indonesia.tripcanvas.co/wp-content/uploads/2019/09/cover-picture-tripcanvas-indo-bromo.jpg',
    bannerLogo: 'https://indonesia.tripcanvas.co/wp-content/uploads/2015/05/Tripcanvas-banner.png',
    tagline: '非一般的印尼旅游攻略',
    guideButtons: [
      { label: '巴厘岛', href: '/zh/bali/' },
      { label: '日惹', href: '/zh/jogja/' },
    ],
  },
  'th_en': {
    bgImage: 'https://thailand.tripcanvas.co/wp-content/uploads/2016/03/facebook-cover-tripcanvas-thailand-1200.jpg',
    bannerLogo: 'https://indonesia.tripcanvas.co/wp-content/uploads/2015/05/Tripcanvas-banner.png',
    tagline: 'Not Your Usual Thailand Travel Guide',
    guideButtons: [
      { label: 'Bangkok Guide', href: '/bangkok/' },
      { label: 'Phuket Guide', href: '/phuket/' },
      { label: 'Chiang Mai Guide', href: '/chiang-mai/' },
      { label: 'Khao Yai Guide', href: '/khao-yai/' },
    ],
  },
  'th_zh': {
    bgImage: 'https://thailand.tripcanvas.co/wp-content/uploads/2016/03/facebook-cover-tripcanvas-thailand-1200.jpg',
    bannerLogo: 'https://indonesia.tripcanvas.co/wp-content/uploads/2015/05/Tripcanvas-banner.png',
    tagline: '非一般的泰国旅游攻略',
    guideButtons: [
      { label: '曼谷', href: '/zh/bangkok/' },
      { label: '华欣', href: '/zh/hua-hin/' },
      { label: '清迈', href: '/zh/chiang-mai/' },
      { label: '考艾', href: '/zh/khao-yai/' },
    ],
  },
  'th_id': {
    bgImage: 'https://thailand.tripcanvas.co/wp-content/uploads/2016/03/facebook-cover-tripcanvas-thailand-1200.jpg',
    bannerLogo: 'https://indonesia.tripcanvas.co/wp-content/uploads/2015/05/Tripcanvas-banner.png',
    tagline: 'Bukan Panduan Liburan Thailand Biasa Anda',
    guideButtons: [
      { label: 'Panduan Bangkok', href: '/id/bangkok/' },
      { label: 'Panduan Hua Hin', href: '/id/hua-hin/' },
      { label: 'Panduan Khao Yai', href: '/id/khao-yai/' },
      { label: 'Panduan Kanchanaburi', href: '/id/kanchanaburi/' },
    ],
  },
};

const configKey = `${market}_${locale}`;
const config = HERO_CONFIG[configKey] || HERO_CONFIG[`${market}_en`] || HERO_CONFIG.id_id;
const social = MARKET_SOCIAL[market];
const rssUrl = localePath('/rss.xml', locale);

function lh(href: string): string {
  if (href.startsWith('http')) return href;
  return localePath(href, locale);
}
---

<div class="full-image-section" style={`background-image: url('${config.bgImage}'); background-attachment: fixed;`}>
  <div class="fullsection">
    <div class="overlay" style="text-align: center; opacity: 0.35;"></div>
    <div class="fullcontent container" style="text-align: center;">
      <div class="col-md-8 col-md-offset-2">
        <h1 class="title" style="margin-bottom: 0; margin-right: 0;">
          <a href={lh('/')}><img src={config.bannerLogo} alt="TripCanvas" /></a>
        </h1>
        <p class="subtitle" style="color: #ddd; margin-bottom: 30px;">{config.tagline}</p>
        <div class="search-form search" style="margin: 0 auto 30px;">
          <form class="search-form" action={lh('/')} method="get" name="SearchForm">
            <label>
              <input class="search-field" style="background: rgba(255,255,255,.8); border-radius: 2px; height: 57px; font-size: 16px; padding-left: 40px;" name="s" type="search" value="" placeholder="What are you looking for?" />
              <i class="fa fa-search searchbutton" style="line-height: 55px; color: #555; padding-right: 20px;"></i>
            </label>
          </form>
        </div>
        {config.guideButtons.length > 0 && (
          <p style="margin-bottom: 40px;">
            {config.guideButtons.map((btn) => (
              <a class="button outline" href={lh(btn.href)} style="margin: 0 5px;">{btn.label}</a>
            ))}
          </p>
        )}
        {social && (
          <div class="topbar-right" style="text-align: center; font-size: 26px; margin-left: 0;">
            {social.facebook && <a href={social.facebook} target="_blank" rel="noopener"><i class="fa fa-facebook-square"></i></a>}
            {social.twitter && <a href={social.twitter} target="_blank" rel="noopener"><i class="fa fa-twitter-square"></i></a>}
            {social.youtube && <a href={social.youtube} target="_blank" rel="noopener"><i class="fa fa-youtube"></i></a>}
            {social.instagram && <a href={social.instagram} target="_blank" rel="noopener"><i class="fa fa-instagram"></i></a>}
            <a href={lh(rssUrl)} target="_blank" rel="noopener"><i class="fa fa-rss"></i></a>
          </div>
        )}
      </div>
    </div>
  </div>
</div>
