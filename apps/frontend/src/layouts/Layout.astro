---
import '../styles/global.css';
import { localePath } from '../lib/locale';
import { t } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TripCanvas',
  description = 'Travel blog and guides'
} = Astro.props;

const locale = ((Astro.locals as { locale?: string }).locale || 'en').toLowerCase();
const homeHref = localePath('/', locale);
const storiesHref = localePath('/blog', locale);
---

<!DOCTYPE html>
<html lang={locale.toLowerCase()}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400&family=Open+Sans:wght@300;400;600&family=Oswald:wght@400;600&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href={homeHref}>
          <span class="brand-mark">TC</span>
          <span class="brand-text">
            <strong>TripCanvas</strong>
            <small>{t('brand.tagline', locale)}</small>
          </span>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href={homeHref}>{t('nav.home', locale)}</a>
          <a href={storiesHref}>{t('nav.stories', locale)}</a>
        </nav>
      </div>
    </header>

    <main class="page-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <p>TripCanvas</p>
        <p>&copy; 2026 · Edge-powered by Cloudflare</p>
      </div>
    </footer>
  </body>
</html>