{
  "name": "tripcanvas-frontend",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && echo '_worker.js' > dist/.assetsignore",
    "preview": "astro preview",
    "deploy": "pnpm build && printf '_worker.js\\n' > dist/.assetsignore && wrangler deploy"
  },
  "dependencies": {
